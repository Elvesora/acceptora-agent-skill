{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/reconciliation-request.schema.json",
  "title": "Checklist reconciliation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "base_checklist_revision",
    "source_descriptor",
    "source_digest",
    "source_manifest",
    "implementation_change_summary",
    "intent_summary",
    "scope_summary",
    "expected_outcome",
    "preconditions",
    "automated_evidence",
    "known_limits",
    "sections",
    "items",
    "addressed_resolution_ids",
    "versions",
    "idempotency_key"
  ],
  "properties": {
    "feature_id": {
      "$ref": "common.schema.json#/$defs/featureId"
    },
    "base_checklist_revision": {
      "type": "integer",
      "minimum": 0
    },
    "source_descriptor": {
      "$ref": "common.schema.json#/$defs/sourceDescriptor"
    },
    "source_digest": {
      "$ref": "common.schema.json#/$defs/sourceDigest"
    },
    "source_manifest": {
      "$ref": "common.schema.json#/$defs/sourceManifest"
    },
    "implementation_change_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "intent_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "scope_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "expected_outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "preconditions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "automated_evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "common.schema.json#/$defs/automatedEvidence"
      }
    },
    "known_limits": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/knownLimit"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/checklistSection"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "common.schema.json#/$defs/reconciliationItem"
      }
    },
    "addressed_resolution_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/resolutionId"
      }
    },
    "versions": {
      "$ref": "common.schema.json#/$defs/versions"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/idempotencyKey"
    }
  }
}
