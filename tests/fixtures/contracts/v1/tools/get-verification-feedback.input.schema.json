{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/tools/get-verification-feedback.input.schema.json",
  "title": "get_verification_feedback input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "open_only",
    "statuses",
    "item_ids",
    "include_attachment_metadata",
    "attachment_read_ids",
    "versions"
  ],
  "properties": {
    "feature_id": {
      "$ref": "../common.schema.json#/$defs/featureId"
    },
    "open_only": {
      "type": "boolean"
    },
    "statuses": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4,
      "items": {
        "$ref": "../enums/feedback-thread-state.schema.json"
      }
    },
    "item_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "$ref": "../common.schema.json#/$defs/itemId"
      }
    },
    "since_cursor": {
      "type": "string",
      "maxLength": 500
    },
    "include_attachment_metadata": {
      "type": "boolean"
    },
    "attachment_read_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^attachment_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "versions": {
      "$ref": "../common.schema.json#/$defs/versions"
    }
  }
}
