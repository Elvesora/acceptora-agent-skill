{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/tools/get-verification-status.output.schema.json",
  "title": "get_verification_status output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "feature_url",
    "feature_status",
    "current_checklist_revision",
    "latest_source_revision_id",
    "latest_source_digest",
    "counts_by_item_state",
    "open_feedback_count",
    "ready_for_recheck_count",
    "source_synchronization_state",
    "final_acceptance_status",
    "correlation_id"
  ],
  "properties": {
    "feature_id": {
      "$ref": "../common.schema.json#/$defs/featureId"
    },
    "feature_url": {
      "type": "string",
      "format": "uri"
    },
    "feature_status": {
      "$ref": "../enums/feature-state.schema.json"
    },
    "current_checklist_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "latest_source_revision_id": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/sourceRevisionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_source_digest": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/sourceDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "counts_by_item_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending",
        "accepted",
        "declined",
        "blocked",
        "skipped",
        "ready_for_recheck",
        "retired"
      ],
      "properties": {
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "declined": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "ready_for_recheck": {
          "type": "integer",
          "minimum": 0
        },
        "retired": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "open_feedback_count": {
      "type": "integer",
      "minimum": 0
    },
    "ready_for_recheck_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_synchronization_state": {
      "type": "string",
      "enum": [
        "synchronized",
        "stale",
        "sync_failed",
        "not_observed"
      ]
    },
    "final_acceptance_status": {
      "type": "string",
      "enum": [
        "never_accepted",
        "valid",
        "invalidated"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
