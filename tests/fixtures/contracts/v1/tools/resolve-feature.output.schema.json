{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/tools/resolve-feature.output.schema.json",
  "title": "resolve_feature output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "canonical_title",
    "resolution_kind",
    "feature_url",
    "status",
    "registered_aliases",
    "candidates",
    "current_checklist_revision",
    "open_feedback_count",
    "correlation_id"
  ],
  "properties": {
    "feature_id": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/featureId"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "resolution_kind": {
      "type": "string",
      "enum": [
        "explicit",
        "exact_alias",
        "created",
        "ambiguous"
      ]
    },
    "feature_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "status": {
      "oneOf": [
        {
          "$ref": "../enums/feature-state.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "registered_aliases": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "../common.schema.json#/$defs/exactAlias"
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "canonical_title",
          "feature_url",
          "reason"
        ],
        "properties": {
          "feature_id": {
            "$ref": "../common.schema.json#/$defs/featureId"
          },
          "canonical_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "feature_url": {
            "type": "string",
            "format": "uri"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "current_checklist_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "open_feedback_count": {
      "type": "integer",
      "minimum": 0
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "resolution_kind": {
            "const": "ambiguous"
          }
        },
        "required": [
          "resolution_kind"
        ]
      },
      "then": {
        "properties": {
          "feature_id": {
            "type": "null"
          },
          "canonical_title": {
            "type": "null"
          },
          "feature_url": {
            "type": "null"
          },
          "status": {
            "type": "null"
          },
          "candidates": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "feature_id": {
            "$ref": "../common.schema.json#/$defs/featureId"
          },
          "canonical_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "feature_url": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "$ref": "../enums/feature-state.schema.json"
          }
        }
      }
    }
  ]
}
