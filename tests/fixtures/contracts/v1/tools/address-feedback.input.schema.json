{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/tools/address-feedback.input.schema.json",
  "title": "address_feedback input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "base_checklist_revision",
    "source_descriptor",
    "source_digest",
    "resolutions",
    "versions",
    "idempotency_key"
  ],
  "properties": {
    "feature_id": {
      "$ref": "../common.schema.json#/$defs/featureId"
    },
    "base_checklist_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_descriptor": {
      "$ref": "../common.schema.json#/$defs/sourceDescriptor"
    },
    "source_digest": {
      "$ref": "../common.schema.json#/$defs/sourceDigest"
    },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "base_thread_version",
          "originating_decision_id",
          "decision_revision",
          "item_id",
          "evaluated_item_revision_id",
          "resolution_summary",
          "evidence_references"
        ],
        "properties": {
          "thread_id": {
            "$ref": "../common.schema.json#/$defs/threadId"
          },
          "base_thread_version": {
            "type": "integer",
            "minimum": 1
          },
          "originating_decision_id": {
            "$ref": "../common.schema.json#/$defs/decisionId"
          },
          "decision_revision": {
            "type": "integer",
            "minimum": 1
          },
          "item_id": {
            "$ref": "../common.schema.json#/$defs/itemId"
          },
          "evaluated_item_revision_id": {
            "$ref": "../common.schema.json#/$defs/itemRevisionId"
          },
          "resolution_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "evidence_references": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "../common.schema.json#/$defs/evidenceReference"
            }
          }
        }
      }
    },
    "versions": {
      "$ref": "../common.schema.json#/$defs/versions"
    },
    "idempotency_key": {
      "$ref": "../common.schema.json#/$defs/idempotencyKey"
    }
  }
}
