{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/tools/address-feedback.output.schema.json",
  "title": "address_feedback output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "source_digest",
    "resolution_ids",
    "thread_states",
    "completion_gate",
    "idempotency_replayed",
    "correlation_id"
  ],
  "properties": {
    "feature_id": {
      "$ref": "../common.schema.json#/$defs/featureId"
    },
    "source_digest": {
      "$ref": "../common.schema.json#/$defs/sourceDigest"
    },
    "resolution_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/resolutionId"
      }
    },
    "thread_states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "thread_version",
          "state"
        ],
        "properties": {
          "thread_id": {
            "$ref": "../common.schema.json#/$defs/threadId"
          },
          "thread_version": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "const": "fix_submitted"
          }
        }
      }
    },
    "completion_gate": {
      "const": "continue_sync"
    },
    "idempotency_replayed": {
      "type": "boolean"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
