{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/tools/check-completion-gate.output.schema.json",
  "title": "check_completion_gate output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "feature_id",
    "reason_code",
    "reason",
    "last_synchronized_digest",
    "last_synchronized_checklist_revision",
    "recovery_instruction",
    "correlation_id"
  ],
  "properties": {
    "outcome": {
      "$ref": "../enums/gate-outcome.schema.json"
    },
    "feature_id": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/featureId"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "maxLength": 100
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "last_synchronized_digest": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/sourceDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_synchronized_checklist_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "recovery_instruction": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
