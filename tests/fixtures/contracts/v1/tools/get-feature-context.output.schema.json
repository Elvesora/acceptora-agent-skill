{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/tools/get-feature-context.output.schema.json",
  "title": "get_feature_context output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature",
    "current_checklist_revision",
    "active_items",
    "retired_items",
    "decisions",
    "unresolved_feedback",
    "previous_source_descriptor",
    "previous_source_digest",
    "known_limits",
    "project_rules",
    "concurrency_token",
    "correlation_id"
  ],
  "properties": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "canonical_title",
        "intent_summary",
        "status",
        "feature_url"
      ],
      "properties": {
        "feature_id": {
          "$ref": "../common.schema.json#/$defs/featureId"
        },
        "canonical_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "intent_summary": {
          "type": "string",
          "maxLength": 5000
        },
        "status": {
          "$ref": "../enums/feature-state.schema.json"
        },
        "feature_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "current_checklist_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "active_items": {
      "$ref": "#/$defs/itemContexts"
    },
    "retired_items": {
      "$ref": "#/$defs/itemContexts"
    },
    "decisions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "item_id",
          "evaluated_item_revision_id",
          "decision",
          "effectiveness",
          "decided_at"
        ],
        "properties": {
          "decision_id": {
            "$ref": "../common.schema.json#/$defs/decisionId"
          },
          "item_id": {
            "$ref": "../common.schema.json#/$defs/itemId"
          },
          "evaluated_item_revision_id": {
            "$ref": "../common.schema.json#/$defs/itemRevisionId"
          },
          "decision": {
            "$ref": "../enums/item-decision.schema.json"
          },
          "effectiveness": {
            "type": "string",
            "enum": [
              "exact",
              "preserved",
              "invalidated",
              "superseded"
            ]
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "unresolved_feedback": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "item_id",
          "state",
          "thread_version"
        ],
        "properties": {
          "thread_id": {
            "$ref": "../common.schema.json#/$defs/threadId"
          },
          "item_id": {
            "$ref": "../common.schema.json#/$defs/itemId"
          },
          "state": {
            "$ref": "../enums/feedback-thread-state.schema.json"
          },
          "thread_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "previous_source_descriptor": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/sourceDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_source_digest": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/sourceDigest"
        },
        {
          "type": "null"
        }
      ]
    },
    "known_limits": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "../common.schema.json#/$defs/knownLimit"
      }
    },
    "project_rules": {
      "type": "object",
      "additionalProperties": true
    },
    "concurrency_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "$defs": {
    "itemContexts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "item_revision_id",
          "definition_version",
          "evaluation_fingerprint",
          "semantic_key",
          "coverage_anchors",
          "section_semantic_key",
          "display_order",
          "current_state"
        ],
        "properties": {
          "item_id": {
            "$ref": "../common.schema.json#/$defs/itemId"
          },
          "item_revision_id": {
            "$ref": "../common.schema.json#/$defs/itemRevisionId"
          },
          "definition_version": {
            "type": "integer",
            "minimum": 1
          },
          "evaluation_fingerprint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "semantic_key": {
            "$ref": "../common.schema.json#/$defs/semanticKey"
          },
          "coverage_anchors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "../common.schema.json#/$defs/coverageAnchor"
            }
          },
          "section_semantic_key": {
            "$ref": "../common.schema.json#/$defs/semanticKey"
          },
          "display_order": {
            "type": "integer",
            "minimum": 0
          },
          "current_state": {
            "$ref": "../enums/item-state.schema.json"
          }
        }
      }
    }
  }
}
