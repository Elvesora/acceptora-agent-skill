{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/tools/record-verification-exception.output.schema.json",
  "title": "record_verification_exception output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exception_id",
    "feature_id",
    "feature_url",
    "source_digest",
    "feature_status",
    "completion_gate",
    "idempotency_replayed",
    "correlation_id"
  ],
  "properties": {
    "exception_id": {
      "$ref": "../common.schema.json#/$defs/exceptionId"
    },
    "feature_id": {
      "$ref": "../common.schema.json#/$defs/featureId"
    },
    "feature_url": {
      "type": "string",
      "format": "uri"
    },
    "source_digest": {
      "$ref": "../common.schema.json#/$defs/sourceDigest"
    },
    "feature_status": {
      "const": "no_manual_verification_required"
    },
    "completion_gate": {
      "const": "pass"
    },
    "idempotency_replayed": {
      "type": "boolean"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
