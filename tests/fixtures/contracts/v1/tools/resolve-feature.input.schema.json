{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/tools/resolve-feature.input.schema.json",
  "title": "resolve_feature input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "source_kind",
    "source_locator",
    "title",
    "intent_summary",
    "requested_feature_id",
    "exact_aliases",
    "canonical_source_fingerprint",
    "allow_create",
    "versions"
  ],
  "properties": {
    "project_id": {
      "$ref": "../common.schema.json#/$defs/projectId"
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "git",
        "pull_request",
        "content",
        "file_manifest",
        "opaque"
      ]
    },
    "source_locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "intent_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "requested_feature_id": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/featureId"
        },
        {
          "type": "null"
        }
      ]
    },
    "exact_aliases": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "../common.schema.json#/$defs/exactAlias"
      }
    },
    "canonical_source_fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "allow_create": {
      "type": "boolean"
    },
    "versions": {
      "$ref": "../common.schema.json#/$defs/versions"
    },
    "idempotency_key": {
      "$ref": "../common.schema.json#/$defs/idempotencyKey"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allow_create": {
            "const": true
          }
        },
        "required": [
          "allow_create"
        ]
      },
      "then": {
        "required": [
          "idempotency_key"
        ]
      }
    }
  ]
}
