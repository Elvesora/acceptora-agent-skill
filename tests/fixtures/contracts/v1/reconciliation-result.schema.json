{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.acceptora.com/contracts/v1/reconciliation-result.schema.json",
  "title": "Checklist reconciliation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "feature_url",
    "source_revision_id",
    "source_digest",
    "new_checklist_revision",
    "feature_status",
    "counts",
    "items_requiring_recheck",
    "open_feedback_count",
    "warnings",
    "known_limits",
    "synchronized_at",
    "idempotency_replayed",
    "correlation_id"
  ],
  "properties": {
    "feature_id": {
      "$ref": "common.schema.json#/$defs/featureId"
    },
    "feature_url": {
      "type": "string",
      "format": "uri"
    },
    "source_revision_id": {
      "$ref": "common.schema.json#/$defs/sourceRevisionId"
    },
    "source_digest": {
      "$ref": "common.schema.json#/$defs/sourceDigest"
    },
    "new_checklist_revision": {
      "type": "integer",
      "minimum": 1
    },
    "feature_status": {
      "$ref": "enums/feature-state.schema.json"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "materially_updated",
        "editorially_updated",
        "reopened",
        "retained",
        "retired"
      ],
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "materially_updated": {
          "type": "integer",
          "minimum": 0
        },
        "editorially_updated": {
          "type": "integer",
          "minimum": 0
        },
        "reopened": {
          "type": "integer",
          "minimum": 0
        },
        "retained": {
          "type": "integer",
          "minimum": 0
        },
        "retired": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items_requiring_recheck": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/itemId"
      }
    },
    "open_feedback_count": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "known_limits": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/knownLimit"
      }
    },
    "synchronized_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_replayed": {
      "type": "boolean"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
