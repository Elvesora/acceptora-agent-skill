{
  "schema_version": 1,
  "api_version": "v1",
  "base_path": "/api/v1/integrations",
  "openapi_path": "/api/v1/integrations/openapi.json",
  "project": {
    "name": "project",
    "method": "GET",
    "path": "/api/v1/integrations/project",
    "authentication": "bearer",
    "required_scope": "projects:read"
  },
  "operations": [
    {
      "name": "resolve_feature",
      "method": "POST",
      "path": "/api/v1/integrations/features/resolve",
      "required_scope": "features:resolve",
      "read_only": false
    },
    {
      "name": "get_feature_context",
      "method": "POST",
      "path": "/api/v1/integrations/features/context",
      "required_scope": "features:read",
      "read_only": true
    },
    {
      "name": "reconcile_checklist",
      "method": "POST",
      "path": "/api/v1/integrations/checklists/reconcile",
      "required_scope": "checklists:write",
      "read_only": false
    },
    {
      "name": "get_verification_feedback",
      "method": "POST",
      "path": "/api/v1/integrations/feedback/query",
      "required_scope": "feedback:read",
      "read_only": true
    },
    {
      "name": "address_feedback",
      "method": "POST",
      "path": "/api/v1/integrations/feedback/address",
      "required_scope": "feedback:address",
      "read_only": false
    },
    {
      "name": "get_verification_status",
      "method": "POST",
      "path": "/api/v1/integrations/status",
      "required_scope": "features:read",
      "read_only": true
    },
    {
      "name": "check_completion_gate",
      "method": "POST",
      "path": "/api/v1/integrations/completion-gate",
      "required_scope": "gates:read",
      "read_only": true
    },
    {
      "name": "record_verification_exception",
      "method": "POST",
      "path": "/api/v1/integrations/verification-exceptions",
      "required_scope": "exceptions:write",
      "read_only": false
    }
  ],
  "legacy_aliases": [
    {
      "name": "legacy_completion_gate",
      "method": "POST",
      "path": "/api/integrations/completion-gate",
      "operation": "check_completion_gate"
    }
  ],
  "human_authority_excluded": [
    "accept",
    "decline",
    "dismiss_feedback",
    "archive",
    "restore",
    "delete",
    "final_acceptance"
  ]
}
