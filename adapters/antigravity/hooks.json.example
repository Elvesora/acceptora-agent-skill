{
  "acceptora-target:{{RUNTIME_ID}}": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/trusted_adapters/antigravity/task_start.py\"",
        "timeout": 60
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/trusted_adapters/antigravity/stop.py\"",
        "timeout": 120
      }
    ]
  }
}
