{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/adapters/codex/task_start.py\"",
            "commandWindows": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/adapters/codex/task_start.py\"",
            "timeout": 60,
            "statusMessage": "Capturing verification baseline"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/adapters/codex/task_start.py\"",
            "commandWindows": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/adapters/codex/task_start.py\"",
            "timeout": 60,
            "statusMessage": "Capturing task verification baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/adapters/codex/stop.py\"",
            "commandWindows": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/adapters/codex/stop.py\"",
            "timeout": 120,
            "statusMessage": "Checking manual-verification synchronization"
          }
        ]
      }
    ]
  }
}
