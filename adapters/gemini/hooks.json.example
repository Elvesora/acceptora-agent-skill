{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "acceptora-capture-session-baseline",
            "type": "command",
            "command": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/adapters/gemini/task_start.py\"",
            "timeout": 60000,
            "description": "Capture the deterministic source baseline when Gemini CLI starts or resumes a session."
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "acceptora-capture-task-baseline",
            "type": "command",
            "command": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/adapters/gemini/task_start.py\"",
            "timeout": 60000,
            "description": "Capture the deterministic source baseline after a prompt and before agent planning."
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "acceptora-check-completion-gate",
            "type": "command",
            "command": "{{PYTHON_COMMAND}} \"{{RUNTIME_ROOT}}/adapters/gemini/after_agent.py\"",
            "timeout": 120000,
            "description": "Check exact-source manual-verification synchronization before Gemini CLI completes a turn."
          }
        ]
      }
    ]
  }
}
