{
  "mcpServers": {
    "acceptora": {
      "command": "{{PYTHON_EXECUTABLE}}",
      "args": [
        "-B",
        "-I",
        "{{RUNTIME_ROOT}}/package/adapters/antigravity/mcp_stdio_bridge.py",
        "--server-url",
        "https://verify.example.test/mcp",
        "--token-env",
        "ACCEPTORA_AGENT_TOKEN_PROJ_REPLACE_WITH_PROJECT_ULID"
      ],
      "disabled": false
    }
  }
}
