        "settings": {
          "base": "client_config",
          "path": "settings.json"
        },
        "mcp": {
          "base": "client_config_parent",
          "path": ".claude.json"
        }
      },
      "templates": {
        "hooks": {
          "default": "adapters/claude/settings.json.example",
          "platform_overrides": {
            "windows": "adapters/claude/settings.windows.json.example"
          }
        },
        "mcp": {
          "path": "config/claude-mcp.example.json",
          "renderer": "claude_json"
        }
      },
      "runtime_adapters": [
        "adapters/claude/task_start.py",
        "adapters/claude/stop.py"
      ],
      "lifecycle": {
        "baseline_events": [
          "SessionStart",
          "UserPromptSubmit"
        ],
        "completion_event": "Stop",
        "update_check_event": "SessionStart"
      },
      "discovery_checks": [
        "/skills",
        "/mcp or claude mcp list",
        "/hooks"
      ],
      "official_docs": {
        "skills": "https://code.claude.com/docs/en/skills",
        "hooks": "https://code.claude.com/docs/en/hooks",
        "mcp": "https://code.claude.com/docs/en/mcp",
        "configuration": "https://code.claude.com/docs/en/settings"
      }
    },
    {
      "id": "gemini-cli",
      "display_name": "Gemini CLI",
      "reference_build": "0.56.0",
      "minimum_build": null,
      "project_layout": {
        "skill_directory": ".gemini/skills/acceptora",
        "instruction_file": "GEMINI.md",
        "instruction_source": "snippets/GEMINI.md.block"
      },
      "user_config": {
        "default_directory": ".gemini",
        "settings": {
          "base": "client_config",
          "path": "settings.json"
