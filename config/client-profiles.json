{
  "schema_version": 1,
  "capabilities_reviewed_on": "2026-08-23",
  "clients": [
    {
      "id": "codex",
      "display_name": "Codex",
      "reference_build": "codex-cli 0.147.0",
      "minimum_build": "codex-cli 0.144.0",
      "project_layout": {
        "skill_directory": ".agents/skills/acceptora",
        "instruction_file": "AGENTS.md",
        "instruction_source": "snippets/AGENTS.md.block"
      },
      "user_config": {
        "default_directory": ".codex",
        "settings": {
          "base": "client_config",
          "path": "hooks.json"
        },
        "mcp": {
          "base": "client_config",
          "path": "config.toml"
        }
      },
      "templates": {
        "hooks": {
          "default": "adapters/codex/hooks.json.example",
          "platform_overrides": {}
        },
        "mcp": {
          "path": "config/codex-mcp.example.toml",
          "renderer": "codex_toml"
        }
      },
      "runtime_adapters": [
        "adapters/codex/task_start.py",
        "adapters/codex/stop.py"
      ],
      "lifecycle": {
        "baseline_events": [
          "SessionStart",
          "UserPromptSubmit"
        ],
        "completion_event": "Stop",
        "update_check_event": "SessionStart"
      },
      "discovery_checks": [
        "/skills",
        "/mcp or codex mcp list",
        "/hooks and review changed hook definitions"
      ],
      "official_docs": {
        "skills": "https://developers.openai.com/codex/skills",
        "hooks": "https://developers.openai.com/codex/hooks",
        "mcp": "https://developers.openai.com/codex/mcp",
        "configuration": "https://developers.openai.com/codex/config-reference"
      }
    },
    {
      "id": "claude-code",
