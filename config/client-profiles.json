        "mcp": {
          "base": "client_config",
          "path": "settings.json"
        }
      },
      "templates": {
        "hooks": {
          "default": "adapters/gemini/hooks.json.example",
          "platform_overrides": {}
        },
        "mcp": {
          "path": "config/gemini-mcp.example.json",
          "renderer": "gemini_json"
        }
      },
      "runtime_adapters": [
        "adapters/gemini/task_start.py",
        "adapters/gemini/after_agent.py"
      ],
      "lifecycle": {
